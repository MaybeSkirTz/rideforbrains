# Copier dans .dev.vars pour le développement. Aucun secret réel dans Git.
APP_ENV=development
APP_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Stripe : clés sk_test_ seulement pendant la validation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_MODE=test
RESEND_API_KEY=
MAIL_FROM=
RESEND_WEBHOOK_SECRET=
MAIL_DAILY_LIMIT=90
# Facultatif localement, requis pour ouvrir au public
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Protection MFA du personnel en production : Cloudflare Access
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

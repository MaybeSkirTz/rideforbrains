{
  "name": "ride-for-brains",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader runner",
    "check": "tsc --noEmit",
    "build:worker": "vite build --config vite.worker.config.ts --configLoader runner",
    "test": "npm run build:worker && vite build --config vite.tasks.config.ts --configLoader runner && node --test --test-concurrency=1 tests/*.test.mjs",
    "db:local": "node scripts/db-local.mjs",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "cloudflare:database": "node scripts/cloudflare-database.mjs",
    "deploy": "node scripts/publish.mjs",
    "admin": "node scripts/admin.mjs",
    "backup": "wrangler d1 export DB --remote --output=backup.sql"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.14",
    "jose": "^6.1.0",
    "svix": "^1.80.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "jsqr": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.0.0",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "4.156.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5"
  }
}

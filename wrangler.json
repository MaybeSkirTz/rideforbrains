{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ride-for-brains",
  "keep_vars": true,
  "main": "server/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/",
      "/activites",
      "/participants",
      "/organisation",
      "/activites/*",
      "/cause",
      "/equipe",
      "/infos",
      "/faq",
      "/benevoles",
      "/partenaires",
      "/conditions",
      "/confidentialite",
      "/connexion",
      "/compte",
      "/espace",
      "/mon-jour-j",
      "/r/*",
      "/equipes",
      "/equipes/*",
      "/histoires",
      "/pour-eux",
      "/ma-communaute",
      "/impact",
      "/souvenir/*",
      "/en",
      "/en/*",
      "/ou-va-mon-argent",
      "/inscription",
      "/attente",
      "/billet/*",
      "/billet-personnel",
      "/recu/*",
      "/confirmer-courriel",
      "/transfert",
      "/autorisations-parentales",
      "/admin",
      "/admin/*",
      "/sitemap.xml",
      "/robots.txt",
      "/calendrier.ics",
      "/velo",
      "/course",
      "/marche",
      "/contact",
      "/benevolat",
      "/parcours",
      "/annulation",
      "/desabonnement",
      "/courriels-locaux",
      "/organisation/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ride-for-brains",
      "database_id": "f872c3f9-bb79-4fb7-9900-5fbdfc11f27d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://rideforbrains.ca",
    "PAYMENTS_MODE": "live"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ride-for-brains-media"
    }
  ]
}

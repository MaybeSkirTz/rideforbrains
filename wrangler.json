{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ride-for-brains",
  "main": "server/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ride-for-brains",
      "database_id": "f872c3f9-bb79-4fb7-9900-5fbdfc11f27d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://ride-for-brains.brainevent.workers.dev",
    "PAYMENTS_MODE": "test"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
